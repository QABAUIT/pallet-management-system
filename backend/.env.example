# Sao chép file này thành .env (đã được gitignore) rồi chỉnh giá trị.
# docker-compose.yml đọc các biến này.
POSTGRES_DB=pallet_db
POSTGRES_USER=pallet
POSTGRES_PASSWORD=pallet_dev_password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Spring Boot đọc các biến dưới đây từ môi trường (hoặc IDE Run Configuration).
DB_URL=jdbc:postgresql://localhost:5432/pallet_db
DB_USERNAME=pallet
DB_PASSWORD=pallet_dev_password
JWT_SECRET=thay-bang-mot-chuoi-ngau-nhien-toi-thieu-32-ky-tu
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads
